# Chat uses OpenRouter when OPENROUTER_API_KEY is set.
# Set AI_PROVIDER=openai or AI_PROVIDER=lovable to force another backend.
# Dictation still uses OPENAI_API_KEY when that key is set.
# Live voice still requires LOVABLE_API_KEY.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Server-side credential for the Lovable AI gateway.
LOVABLE_API_KEY=

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# AI_PROVIDER=
